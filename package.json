{
  "name": "@type32/jsoncanvas-editor",
  "version": "0.1.2",
  "description": "An Obsidian-style JSON Canvas editor for Nuxt and Vue, built on Nuxt UI.",
  "repository": "https://github.com/Type-32/jsoncanvas-editor-nuxt",
  "keywords": [
    "json-canvas",
    "canvas",
    "obsidian",
    "nuxt",
    "nuxt-module",
    "vue",
    "nuxt-ui",
    "whiteboard"
  ],
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./core": {
      "types": "./dist/runtime/core/index.d.ts",
      "import": "./dist/runtime/core/index.js"
    },
    "./vue": {
      "types": "./dist/runtime/vue/index.d.ts",
      "import": "./dist/runtime/vue/index.js"
    },
    "./style.css": "./dist/runtime/style.css"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "core": [
        "./dist/runtime/core/index.d.ts"
      ],
      "vue": [
        "./dist/runtime/vue/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "bun run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "bench": "bun run dev:prepare && nuxi build playground && echo 'Open http://localhost:3000/bench?run' && nuxi preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "bun run prepack && changelogen --release && bun publish && git push --follow-tags",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@comark/vue": "^0.9.1",
    "@nuxt/kit": "^4.6.4",
    "@vueuse/core": "^15.0.0",
    "comark": "^0.9.1"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.12.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.4",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "vue-demi"
  ]
}
